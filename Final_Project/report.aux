\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Fe\,(110) 吸附构型。\textbf  {甲硫醇、二甲硫醚发生解离式吸附}（S--C 键断裂）， 吸附能分别为 $-3.991$ 和 $-2.189$\,eV（w.D3）； \textbf  {二烯丙基二硫以碳碳双键吸附}而非 S 吸附，吸附能较弱（$-1.525$\,eV）。}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:fe_adsorb}{{2}{3}{Fe\,(110) 吸附构型。\textbf {甲硫醇、二甲硫醚发生解离式吸附}（S--C 键断裂）， 吸附能分别为 $-3.991$ 和 $-2.189$\,eV（w.D3）； \textbf {二烯丙基二硫以碳碳双键吸附}而非 S 吸附，吸附能较弱（$-1.525$\,eV）。}{figure.caption.3}{}}
