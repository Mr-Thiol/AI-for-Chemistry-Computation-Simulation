\newlabel{fig:cr_ch3sh}{{1b}{3}{Cr\,(111) 表面吸附甲硫醇}{figure.caption.2}{}}
\newlabel{sub@fig:cr_ch3sh}{{b}{3}{Cr\,(111) 表面吸附甲硫醇}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cr\,(111) 吸附构型。\textbf  {甲硫醇、二甲硫醚、二烯丙基二硫均发生解离式吸附}（S--C 键断裂）， 其中二烯丙基二硫吸附能达 $-8.256$\,eV（w.D3）。解离吸附使 S 原子直接与多个 Cr 原子成键， 形成强配位，是 Cr 表面吸附能最强的关键。}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:cr_adsorb}{{1}{3}{Cr\,(111) 吸附构型。\textbf {甲硫醇、二甲硫醚、二烯丙基二硫均发生解离式吸附}（S--C 键断裂）， 其中二烯丙基二硫吸附能达 $-8.256$\,eV（w.D3）。解离吸附使 S 原子直接与多个 Cr 原子成键， 形成强配位，是 Cr 表面吸附能最强的关键。}{figure.caption.2}{}}
\newlabel{fig:fe_ch3sh}{{2a}{3}{Fe\,(110) 表面吸附甲硫醇}{figure.caption.3}{}}
